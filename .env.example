SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SELLER_HUB_URL=https://vendor-admin-6f5h.vercel.app/

# Map provider experiment. OSM/MapLibre remains the default.
VITE_MAP_PROVIDER=osm
# Required only when VITE_MAP_PROVIDER=google; use a browser-restricted key.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
VITE_CUSTOMER_CARE_PHONE=+91XXXXXXXXXX

# Public Client Credentials
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Server-side ONLY Credentials (Never use VITE_ prefix, never expose to browser client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Optional dedicated TEST keys for imported prototype shops. If omitted,
# RAZORPAY_KEY_ID/SECRET are reused only when the key ID starts with rzp_test_.
# Never use VITE_ for the test secret or replace live seller credentials.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
REDIS_URL=redis://user:password@host:port
